/ One line above the board comparing the roadmap against what the tickets are
/ doing. Quiet when they agree; the findings only unfold on demand.
- a = alignment
- return unless a.configured?
- tone = a.aligned? ? "ok" : "warn"

section.kb-roadmap data-tone=tone data-controller="roadmap"
  button.kb-roadmap-head type="button" data-action="roadmap#toggle" data-roadmap-target="btn" data-open="0" aria-expanded="false"
    span.kb-roadmap-label ROADMAP
    span.kb-roadmap-summary
      | Now: #{a.now_on_board} of #{a.now_total} on the board
      - if a.needs_attention > 0
        span.kb-roadmap-sep ·
        span.kb-roadmap-attention= "#{a.needs_attention} need attention"
      - if (s = a.landing_summary)
        span.kb-roadmap-sep ·
        span.lq-summary
          span.lq-tag class="lq-s-#{s.at_risk.positive? || s.late.positive? ? 'risk' : 'track'}"
            span.lq-mono= s.quarter.letter
            = s.quarter.short_label
          = " #{s.quarter.codename}: " if s.quarter.codename
          = " " unless s.quarter.codename
          = "#{s.targeted} targeted · #{s.landed} landed"
          - if s.at_risk.positive?
            | &nbsp;·&nbsp;
            span.kb-roadmap-attention= "#{s.at_risk} at risk"
          - if s.late.positive?
            | &nbsp;·&nbsp;
            span.kb-roadmap-attention.lq-late-text= "#{s.late} late"
          = " · #{s.days_left} days left"
    - if a.findings.any?
      - active = a.active_findings.size
      - snoozed = a.snoozed_findings.size
      span.kb-roadmap-trail
        = "#{active} #{'notice'.pluralize(active)}"
        - if snoozed.positive?
          span.lq-snoozed-count= " · #{snoozed} snoozed"
        svg.kb-roadmap-chev width="9" height="9" viewBox="0 0 9 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
          path d="M2 3.5L4.5 6L7 3.5"

  - if a.findings.any? || a.landing_summary
    .kb-roadmap-body data-roadmap-target="body" hidden=true
      / Landing warnings can be snoozed with a right-click, like stale tickets.
      - (a.active_findings + a.snoozed_findings).each do |f|
        - landing = LandingHelper::LANDING_FINDING_KINDS.include?(f.kind)
        = tag.div class: [ "kb-roadmap-finding", ("is-snoozed" if f.snooze) ], data: { severity: f.severity, **(landing ? landing_snooze_data(f.key, f.snooze, f.headline) : {}) } do
          span.kb-roadmap-dot
          .kb-roadmap-finding-text
            .kb-roadmap-finding-head
              a.kb-roadmap-finding-key href=jira_url(f.key) target="_blank" rel="noreferrer"= f.key
              span.kb-roadmap-finding-title= f.headline
              - if f.snooze
                span.lq-finding-snooze
                  = snooze_icon_svg(size: 9)
                  = " snoozed #{snooze_summary(f.snooze)}"
            .kb-roadmap-finding-detail= f.detail
            - if landing && !f.snooze
              .lq-finding-hint Right-click to snooze
      - if a.landing_summary
        a.lq-roadmap-link href=roadmap_path Open the roadmap timeline →
