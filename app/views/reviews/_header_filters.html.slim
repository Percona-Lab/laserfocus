/ Left of the counts, where the board has Status, Activity and the ghost
/ button. The Reviews filters sit on top of an invisible copy of those, so this
/ slot is exactly as wide as on the board and the tabs never move.
.kb-filters-slot
  .kb-filters-reserve aria-hidden="true"
    = render "shared/header_filters", enabled: false
  .kb-filters-over
    .kb-filter-wrap data-controller="filter-dropdown" data-action="click@window->filter-dropdown#closeIfOutside"
      button.kb-filter-btn type="button" data-action="filter-dropdown#toggle" data-reviews-target="repoBtn" data-on="0" aria-label="Filter by repository"
        span.kb-filter-badge data-reviews-target="repoBadge" hidden=true
        | Repo
        svg width="8" height="8" viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
          path d="M1 2.5L4 5.5L7 2.5"
      .kb-filter-menu.kb-repo-menu data-filter-dropdown-target="menu" hidden=true
        p.kb-filter-section-label Repositories
        - shown, excluded = presenter.repos.partition { |r, _| !presenter.excluded?(r) }
        - shown.sort_by { |r, n| [ -n, r.downcase ] }.each do |repo, count|
          = render "reviews/repo_row", repo: repo, count: count, excluded: false, presenter: presenter
        - if excluded.any?
          p.kb-filter-section-label title="Hidden from your view only. Right-click one to include it again." Excluded
          - excluded.sort_by { |r, _| r.downcase }.each do |repo, count|
            = render "reviews/repo_row", repo: repo, count: count, excluded: true, presenter: presenter
        p.kb-repo-hint Right-click a repo to exclude it from your view
        .kb-filter-divider
        button.kb-filter-clear type="button" data-reviews-target="repoClear" data-action="reviews#clearRepos" hidden=true
          | ✕ Clear selection

      / Right-click menu on a repo row. Inside the dropdown's wrap, so clicking
      / it does not close the dropdown.
      .kb-repo-ctx role="menu" data-reviews-target="repoCtx" hidden=true
        button.kb-repo-ctx-btn type="button" role="menuitem" data-reviews-target="repoCtxBtn" data-action="reviews#toggleExclude"

    button.kb-ghost-btn.kb-community-btn type="button" data-reviews-target="communityBtn" data-action="reviews#toggleCommunity" data-on="0" title=presenter.copy[:community_hint]
      | 🌱
