/ Everything to the right of the view tabs. Next renders it too, with the
/ ticket controls switched off, so the tabs sit in the same spot on every view.
/ Reviews and Issues pass their presenter as reviews: and get search and
/ People wired to their own items, plus scope pills where the grouping pills
/ sit. The presenter's copy holds the wording (PRs or issues).
- off_hint = "Only on Board and Community"
- reviews = local_assigns[:reviews]
- copy = reviews&.copy
- if reviews
  .kb-group-mode.kb-scope-mode role="group" aria-label="Whose #{copy[:nouns]}"
    / Holds exactly the room the board's grouping pills take, so the tabs
    / stay put; the scope pills sit on top of it.
    .kb-scope-reserve aria-hidden="true"
      - group_mode_options.each do |_, opt|
        span.kb-act-pill= opt[:label]
    .kb-scope-pills
      - linked = reviews.viewer_linked?
      button.kb-act-pill type="button" data-reviews-target="scopeBtn" data-action="reviews#chooseScope" data-scope="all" data-on="1" title=copy[:all_hint] All
      button.kb-act-pill type="button" data-reviews-target="scopeBtn" data-action="reviews#chooseScope" data-scope="me" data-on="0" disabled=!linked title=(linked ? copy[:needs_me_hint] : reviews.viewer_hint) Needs me
      button.kb-act-pill type="button" data-reviews-target="scopeBtn" data-action="reviews#chooseScope" data-scope="mine" data-on="0" disabled=!linked title=(linked ? copy[:mine_hint] : reviews.viewer_hint) Mine
- else
  .kb-group-mode role="group" aria-label="Column grouping" data-controller=(enabled ? "group-mode" : nil)
    - group_mode_options.each do |mode, opt|
      button.kb-act-pill type="button" data-action=(enabled ? "group-mode#choose" : nil) data-mode=mode data-on=(enabled && @group_mode == mode ? "1" : "0") title=(enabled ? opt[:hint] : off_hint) disabled=!enabled
        = opt[:label]

/ Column order, only where landing quarters are set up. Rendered (switched off)
/ on every view, like the grouping, so the tabs keep their place.
- if LASER_FOCUS_CONFIG.discovery&.landing?
  - sort_on = enabled && !reviews
  .kb-activity-pills.kb-column-sort role="group" aria-label="Column order" data-controller=(sort_on ? "column-sort" : nil)
    - [ [ "manual", "Board order", "The order everyone shares: drag columns to change it" ], [ "landing", "By landing", "Earliest landing quarter first, riskiest first within a quarter. Remembered per browser" ] ].each do |sort, label, hint|
      button.kb-act-pill type="button" data-action=(sort_on ? "column-sort#choose" : nil) data-sort=sort data-on=(sort_on && (@column_sort || "manual") == sort ? "1" : "0") title=(sort_on ? hint : off_hint) disabled=!sort_on
        = label

.kb-search-wrap
  svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="#94a3b8" stroke-width="1.6" aria-hidden="true"
    circle cx="6" cy="6" r="4.2"
    path d="M9.2 9.2L13 13" stroke-linecap="round"
  - if reviews
    input.kb-search type="search" placeholder="Search #{copy[:nouns]}…" data-reviews-target="search" data-action="input->reviews#search" autocomplete="off" aria-label="Search #{copy[:nouns]}"
  - else
    input.kb-search type="search" placeholder="Search tickets…" data-board-target=(enabled ? "search" : nil) data-action=(enabled ? "input->board#search" : nil) autocomplete="off" disabled=!enabled title=(enabled ? nil : off_hint)

- if reviews
  .kb-people data-controller="filter-dropdown" data-action="click@window->filter-dropdown#closeIfOutside"
    button.kb-people-btn type="button" data-reviews-target="peopleBtn" data-action="filter-dropdown#toggle" data-on="0" title=copy[:people_hint]
      svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="#64748b" stroke-width="1.5" aria-hidden="true"
        circle cx="7" cy="4.5" r="2.3"
        path d="M2.5 12c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4" stroke-linecap="round"
      span data-people-target="label" data-reviews-target="peopleLabel"
        | People
      svg width="9" height="9" viewBox="0 0 9 9" fill="none" stroke="#94a3b8" stroke-width="1.6" aria-hidden="true"
        path d="M2 3.5L4.5 6 7 3.5" stroke-linecap="round"
    .kb-people-menu.kb-review-people data-filter-dropdown-target="menu" data-team=reviews.team_logins.map(&:downcase).join(" ") hidden=true
      p.kb-filter-section-label Show #{copy[:nouns]} where they…
      .kb-seg role="group" aria-label="Match people as"
        - copy[:roles].each do |role, label|
          button type="button" data-reviews-target="roleBtn" data-action="reviews#chooseRole" data-role=role data-on=(role == "any" ? "1" : "0") = label
      button.kb-people-row type="button" data-reviews-target="noReplyRow" data-action="reviews#toggleNoReply" data-on="0"
        span.kb-people-glyph.kb-people-glyph-none ∅
        span.kb-people-who
          span.name No reply yet
          small= copy[:no_reply_hint]
        span.kb-people-n= reviews.no_reply_count
        = people_check_svg
      - if reviews.team_logins.any?
        button.kb-people-row type="button" data-reviews-target="teamRow" data-action="reviews#toggleTeam" data-on="0"
          span.kb-people-glyph.kb-people-glyph-team ★
          span.kb-people-who
            span.name My team
            small= "#{reviews.team_logins.size} on open #{copy[:nouns]}, matched to board.users"
          = people_check_svg
      .kb-people-sep
      - [ [ "Team", reviews.team_logins ], [ "Outside the team", reviews.outside_logins ] ].each do |title, logins|
        - next if logins.empty?
        p.kb-filter-section-label= title
        - logins.each do |login|
          - inv = reviews.involvement(login)
          - av = avatar_for(github_person(login))
          button.kb-people-row type="button" data-reviews-target="personRow" data-action="reviews#togglePerson" data-login=login.downcase data-wrote=inv[:wrote] data-replied=inv[:replied] data-asked=inv[:asked] data-on="0" title=login
            span.kb-avatar style="background:#{av[:color]};width:22px;height:22px;font-size:9.2px;"
              = av[:initials]
            span.kb-people-who
              span.name= github_person(login)
              small= [ ("#{inv[:wrote]} #{copy[:wrote]}" if inv[:wrote].positive?), ("#{inv[:replied]} #{copy[:replied]}" if inv[:replied].positive?), ("#{inv[:asked]} #{copy[:asked]}" if inv[:asked].positive?) ].compact.join(" · ")
            span.kb-people-n data-reviews-target="personCount"
            = people_check_svg
      - if reviews.unmatched_members.any?
        p.kb-filter-section-label title="Either nothing of theirs is open, or their GitHub profile name differs from Jira. Add github: to their board.users entry to link them." Team, not on open #{copy[:nouns]}
        - reviews.unmatched_members.each do |user|
          .kb-people-row.kb-people-row-off
            - av = avatar_for(user.display_name)
            span.kb-avatar style="background:#{av[:color]};width:22px;height:22px;font-size:9.2px;"
              = av[:initials]
            span.kb-people-who
              span.name= user.display_name
              small Not matched to a GitHub login
      button.kb-people-clear type="button" data-reviews-target="peopleClear" data-action="reviews#clearPeople" hidden=true
        | ✕ Clear selection
- else
  .kb-people data-controller=(enabled ? "people" : nil) data-action=(enabled ? "click@window->people#closeIfOutside" : nil)
    button.kb-people-btn type="button" data-people-target="btn" data-action=(enabled ? "people#toggle" : nil) data-on="0" disabled=!enabled title=(enabled ? nil : off_hint)
      svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="#64748b" stroke-width="1.5" aria-hidden="true"
        circle cx="7" cy="4.5" r="2.3"
        path d="M2.5 12c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4" stroke-linecap="round"
      span data-people-target="label"
        | People
      svg width="9" height="9" viewBox="0 0 9 9" fill="none" stroke="#94a3b8" stroke-width="1.6" aria-hidden="true"
        path d="M2 3.5L4.5 6 7 3.5" stroke-linecap="round"
    - if enabled
      .kb-people-menu data-people-target="menu" hidden=true
        - un = avatar_for("")
        button.kb-people-row type="button" data-people-target="row" data-action="people#toggleRow" data-name="" data-on="0"
          span.kb-avatar style="background:#{un[:color]};width:22px;height:22px;font-size:9.2px;"
            = un[:initials]
          span.name= un[:name]
          svg.check width="14" height="14" viewBox="0 0 14 14" hidden=true aria-hidden="true"
            path d="M3 7.3l2.5 2.5L11 4.2" stroke="#2563eb" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"
        - assignees.each do |name|
          - av = avatar_for(name)
          button.kb-people-row type="button" data-people-target="row" data-action="people#toggleRow" data-name=name data-on="0"
            span.kb-avatar style="background:#{av[:color]};width:22px;height:22px;font-size:9.2px;"
              = av[:initials]
            span.name= av[:name]
            svg.check width="14" height="14" viewBox="0 0 14 14" hidden=true aria-hidden="true"
              path d="M3 7.3l2.5 2.5L11 4.2" stroke="#2563eb" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"
        button.kb-people-clear type="button" data-people-target="clear" data-action="people#clear" hidden=true
          | Clear selection

= render "board/stale_banner", last_sync: last_sync
= render "board/warning_tray", warnings: warnings

= render "shared/display_toggles"
span.kb-user= current_user_email
= button_to "Logout", "/logout", method: :delete, form: { style: "display:inline;margin:0;" }, class: "kb-logout-btn"
