.kb-shell
  header.kb-header
    .kb-brand
      = image_tag "/icon.png", alt: "", class: "kb-brand-logo"
      span.kb-brand-name LaserFocus

    = render "shared/header_filters", enabled: false

    .kb-header-right
      / Always rendered, empty without a roadmap, so it holds the same room as
      / on the board.
      - full = "#{@presenter.rows.size} queued · #{@presenter.ready_count} ready to start · #{@presenter.unlinked_count} with nothing in Jira"
      span.kb-counts title=(@configured ? full : nil)
        - if @configured
          = "#{@presenter.rows.size} queued · #{@presenter.ready_count} ready"
          - if @presenter.unlinked_count > 0
            | &nbsp;·&nbsp;
            span.stale= "#{@presenter.unlinked_count} not in Jira"

      = render "shared/view_tabs", current: :next

      = render "shared/header_tools", enabled: false, assignees: [], last_sync: @last_sync, warnings: @warnings

  - unless @configured
    p.kb-next-empty No Jira Product Discovery roadmap is configured, so there is nothing to show here yet.
  - if @configured && @presenter.rows.empty?
    p.kb-next-empty Nothing sits in the roadmap's Next column right now.

  / Ranked left to right, the way the roadmap orders them. Each column is one
  / Next item; its cards are the readiness steps, so the board's reading of
  / "what's in progress" becomes "what has to happen before we can start".
  main.kb-board.kb-next-board
    - @presenter.rows.each_with_index do |row, i|
      = render "next/column", row: row, rank: i + 1
